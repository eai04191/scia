#!/bin/bash
# ローカルのmainを、`make check`と`make test`の両方が通った中身（Tools/check-stamp.shが覚えたtree）のcommitにしか動かさない。`make hooks`で入れる。
# mainにあったcommitへ戻すのと、mainを消すのは止めない。
# fast-forwardのmergeは、作業ツリーとindexを書き換えてからmainを動かすので、mainを動かす時点で止めると、入れようとした中身が作業ツリーに残る。
# そのため、mergeとpullは、作業ツリーに触る前に更新するORIG_HEADの時点で、相手のcommitを調べて止める。
# 相手は、reflogに残すために渡されるGIT_REFLOG_ACTION（`merge <branch>`、`pull ...`）から読む。読めないとき（`git merge`だけで上流を取り込むときなど）は、mainを動かす時点で止まり、作業ツリーに中身が残る。
# 新しいtreeになるmerge commitは、誰もmake checkとmake testを通していないので止める。mainへはbranchをmainへrebaseしてからfast-forwardで入れる。
set -euo pipefail

[[ "${1:-}" == prepared ]] || exit 0

# main checkoutのスクリプトで調べる。worktreeのbranchにある古い版ではなく、mainの決まりで調べるため
# hookもスクリプトもmain checkoutの作業ファイルなので、mainを動かす時点のmainの版で調べる。記録の置き場所や形を変えるcommitをmainに入れるときは、
# 古い版が新しい置き場所を読めず拒否するので、その1回だけ、古い置き場所にも同じ記録を置いてから入れる

stamp="$(git rev-parse --path-format=absolute --git-common-dir)/../Tools/check-stamp.sh"

checked() {
    [[ -z "$("$stamp" missing "$1")" ]]
}

reject() {
    echo "error: $1" >&2
    exit 1
}

not_checked_message() {
    local steps
    # macOSのpasteは1バイトの区切りしか使えず、日本語でつなぐと文字が壊れるので、awkでつなぐ
    steps=$("$stamp" missing "$1" | awk 'NR > 1 { printf "と" } { printf "%s", $0 }')
    echo "$(git log -1 --format='%h %s' "$1") の中身は、${steps}が通っていないので、mainに入れません。このcommitをcheckoutしたworktreeで${steps}を通してから、入れ直してください"
}

# mergeとpullで取り込もうとしている相手のcommitを出す
merge_targets() {
    local action=${GIT_REFLOG_ACTION:-}
    case "$action" in
        "merge "*)
            local arg
            for arg in ${action#merge }; do
                [[ "$arg" == -* ]] && continue
                # `-m <メッセージ>`のように、commitを指さない引数は飛ばす
                git rev-parse -q --verify "$arg^{commit}" || true
            done
            ;;
        "pull "* | pull)
            git rev-parse -q --verify "FETCH_HEAD^{commit}" || true
            ;;
    esac
}

main=$(git rev-parse -q --verify refs/heads/main || true)

while read -r _old new ref; do
    case "$ref" in
        ORIG_HEAD)
            [[ "$(git symbolic-ref -q HEAD || true)" == refs/heads/main ]] || continue
            for target in $(merge_targets); do
                # 取り込み済みのcommitなら、mainは動かない
                git merge-base --is-ancestor "$target" HEAD && continue
                git merge-base --is-ancestor HEAD "$target" ||
                    reject "mainへはfast-forwardでだけ入れます。$(git log -1 --format='%h' "$target")をmainへrebaseし、make checkとmake testを通してから入れ直してください"
                checked "$target" || reject "$(not_checked_message "$target")"
            done
            ;;
        refs/heads/main)
            [[ "$new" =~ ^0+$ ]] && continue
            [[ -n "$main" ]] && git merge-base --is-ancestor "$new" "$main" && continue
            checked "$new" || reject "$(not_checked_message "$new")"
            ;;
    esac
done
